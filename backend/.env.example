# Optional API keys. Kosongkan untuk melewati provider terkait.
# Search utama (youtube, ytmusic) tidak butuh key apa pun.

# CORS untuk web app (pisahkan dengan koma)
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# TTL cache URL stream (detik)
# STREAM_CACHE_TTL=21600

# API keys opsional
# LASTFM_API_KEY=
# SOUNDCLOUD_CLIENT_ID=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# ---- Akun YouTube (OAuth, multi akun) ----
# Wajib untuk fitur login YouTube. Client dibuat di Google Cloud Console
# (tipe "Web application"), redirect URI harus di daftarkan di konsol dan
# persis sama dengan YOUTUBE_CALLBACK_URI. Lihat docs/setup-google-oauth.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YOUTUBE_CALLBACK_URI=http://127.0.0.1:8000/youtube/callback

# ---- API Key untuk autentikasi ----
# Wajib diisi untuk Vercel deploy. Gunakan string random 32+ karakter.
# API_KEY=ganti-dengan-key-random
